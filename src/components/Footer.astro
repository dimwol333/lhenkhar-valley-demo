---
import Logo from './Logo.astro';
import Divider from './Divider.astro';
import { hotel, navigation, bookingCta } from '../data/hotel';
const year = new Date().getFullYear();
const a = hotel.address;
---

<footer class="bg-primary-900 text-cream-100">
  <div class="container-page pt-16 pb-28 sm:pb-12">
    <Divider tone="dark" class="mb-14" />
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Logo tone="light" />
        <p class="mt-5 max-w-md leading-relaxed text-cream-100/90">{hotel.description}</p>
        <a href={bookingCta.href} class="btn-accent mt-6">{bookingCta.label}</a>
      </div>

      <div>
        <h2 class="font-serif text-2xl text-cream-50">Visit</h2>
        <address class="mt-4 space-y-2 leading-relaxed not-italic text-cream-100/90">
          <p>{hotel.name}<br />{a.street}, {a.region}<br />{a.country}</p>
          <p>
            <a class="hover:text-accent-300" href={`tel:+${hotel.contact.phoneDigits}`}>{hotel.contact.phone}</a><br />
            <a class="hover:text-accent-300" href={`mailto:${hotel.contact.email}`}>{hotel.contact.email}</a>
          </p>
          <p>Check-in {hotel.checkIn} · Check-out {hotel.checkOut}</p>
        </address>
      </div>

      <div>
        <h2 class="font-serif text-2xl text-cream-50">Explore</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-1">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class="text-cream-100/90 hover:text-accent-300">{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 rounded-2xl border border-accent-400/30 bg-primary-800/60 p-5 sm:flex-row sm:items-center">
      <svg class="h-10 w-10 shrink-0 text-accent-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect>
        <rect x="3" y="14" width="7" height="7" rx="1"></rect><path d="M14 14h3v3h-3zM18 18h3v3h-3zM14 20h1M20 14h1"></path>
      </svg>
      <p class="flex-1 font-medium text-cream-50">{hotel.payments.badge}</p>
      <ul class="flex flex-wrap gap-2" aria-label="Accepted payment methods">
        {
          hotel.payments.methods.map((m) => (
            <li class="rounded-md bg-cream-50 px-3 py-1 text-xs font-bold tracking-wide text-primary-800">{m}</li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-cream-50/15 pt-6 text-sm text-cream-100/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {hotel.name}. All rights reserved.</p>
      <ul class="flex gap-5">
        <li><a class="hover:text-accent-300" href={hotel.social.facebook} rel="noopener">Facebook</a></li>
        <li><a class="hover:text-accent-300" href={hotel.social.instagram} rel="noopener">Instagram</a></li>
        <li><a class="hover:text-accent-300" href={hotel.social.tripadvisor} rel="noopener">Tripadvisor</a></li>
      </ul>
    </div>
  </div>
</footer>
