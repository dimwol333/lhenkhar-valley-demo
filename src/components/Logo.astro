---
import { hotel } from '../data/hotel';
interface Props {
  /** 'auto' follows the header colour state, 'light' is for dark backgrounds. */
  tone?: 'auto' | 'dark' | 'light';
}
const { tone = 'auto' } = Astro.props;
const nameColor = { auto: 'text-(--hdr-fg)', dark: 'text-primary-800', light: 'text-cream-50' }[tone];
// Second line of the logo: the rest of the hotel name (e.g. "Retreat") + region.
const nameRest = hotel.name.replace(hotel.shortName, '').trim();
const subColor = { auto: 'text-(--hdr-sub)', dark: 'text-accent-700', light: 'text-accent-300' }[tone];
---

<span class="inline-flex items-center gap-3">
  <svg class="h-10 w-10 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="var(--color-primary-700)"></rect>
    <path d="M12 30 32 15l20 15h-6v4H18v-4z" fill="var(--color-accent-400)"></path>
    <path d="M19 36h26v14H19z" fill="var(--color-cream-50)"></path>
    <path d="M22 39h4v4h-4zM30 39h4v4h-4zM38 39h4v4h-4zM28 44h8v6h-8z" fill="var(--color-primary-700)"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-serif text-xl font-semibold transition-colors duration-500 sm:text-2xl', nameColor]}>{hotel.shortName}</span>
    <span class:list={['mt-1 text-[0.65rem] font-semibold tracking-[0.25em] uppercase transition-colors duration-500', subColor]}>
      {nameRest ? `${nameRest} · ` : ''}{hotel.address.region}
    </span>
  </span>
</span>
