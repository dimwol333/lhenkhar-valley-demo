---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import RevealImage from '../components/RevealImage.astro';
import Divider from '../components/Divider.astro';
import GoldLine from '../components/GoldLine.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stars from '../components/Stars.astro';
import Stats from '../components/Stats.astro';
import Marquee from '../components/Marquee.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { seo, home, reviews, bookingCta, hotel } from '../data/hotel';
const { hero, welcome, highlights, band } = home;
---

<BaseLayout title={seo.home.title} description={seo.home.description} heroImage={hero.image}>
  <!-- ======================= HERO (hero.ts) ======================= -->
  <section class="relative isolate flex min-h-svh items-center overflow-hidden bg-primary-900" data-hero>
    <div class="absolute inset-0 -z-10 overflow-hidden" data-hero-media>
      <Photo image={hero.image} priority widths={[640, 1024, 1440, 2000]} sizes="100vw" class="h-full w-full object-cover" data-hero-img="" />
    </div>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink-900/85 via-ink-900/40 to-ink-900/45"></div>

    <div class="container-page pt-36 pb-32 text-center" data-hero-content>
      <p class="eyebrow mb-6 text-accent-300" data-hero-fade>{hero.eyebrow}</p>
      <!-- Letters rise and fade in one by one -->
      <h1 class="mx-auto max-w-5xl text-6xl leading-[0.95] font-medium text-cream-50 sm:text-8xl lg:text-[9rem]" data-hero-title>
        {hotel.name}
      </h1>
      <p class="mt-6 font-serif text-2xl text-accent-300 italic sm:text-4xl" data-hero-fade>{hero.tagline}</p>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-cream-100 sm:text-lg" data-hero-fade>{hero.subtitle}</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row" data-hero-fade>
        <a href={bookingCta.href} class="btn-accent px-9 text-base">{bookingCta.label}</a>
        <a href="/rooms/" class="btn-outline-light">Explore our rooms</a>
      </div>
    </div>

    <!-- Scroll-down cue -->
    <a
      href="#welcome"
      class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-[0.65rem] font-semibold tracking-[0.3em] text-cream-100 uppercase"
      data-scroll-indicator
      data-hero-fade
    >
      Scroll
      <span class="relative block h-14 w-px overflow-hidden bg-cream-50/25">
        <span class="absolute inset-0 bg-accent-400" data-scroll-line></span>
      </span>
    </a>
  </section>

  <!-- ======================= WELCOME ======================= -->
  <section id="welcome" class="py-24 sm:py-36">
    <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={welcome.eyebrow} title={welcome.title} align="left" />
        <GoldLine class="mt-8 w-32 origin-left!" />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-700">
          {welcome.paragraphs.map((p) => <p data-fade>{p}</p>)}
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <RevealImage image={welcome.image} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-4/5 rounded-[2rem] shadow-2xl" />
      </div>
    </div>
  </section>

  <!-- ======================= STATS (counters) ======================= -->
  <Stats />

  <!-- ======================= MARQUEE ======================= -->
  <Marquee />

  <!-- ======================= HIGHLIGHTS (cards, tilt) ======================= -->
  <section class="py-24 sm:py-36" aria-labelledby="highlights-title">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-4" data-fade>Your stay</p>
        <h2 id="highlights-title" class="text-5xl text-primary-800 sm:text-6xl lg:text-7xl" data-split>Everything for a restful visit</h2>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-3 lg:gap-10">
        {
          highlights.map((h, i) => (
            <div data-fade class:list={[i === 1 && 'md:mt-16']}>
              <article class="group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-white shadow-sm ring-1 ring-cream-200 transition-shadow duration-500 hover:shadow-2xl" data-tilt>
                <div class="overflow-hidden" data-cursor="image">
                  <Photo
                    image={h.image}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    class="aspect-4/5 w-full object-cover transition-[scale] duration-1000 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-[1.08]"
                  />
                </div>
                <div class="flex flex-1 flex-col p-7 sm:p-8">
                  <p class="font-sans text-xs tracking-[0.25em] text-accent-700">0{i + 1}</p>
                  <h3 class="mt-2 text-4xl text-primary-800">{h.title}</h3>
                  <p class="mt-3 flex-1 leading-relaxed text-ink-700">{h.text}</p>
                  <a href={h.href} class="link-arrow mt-6 after:absolute after:inset-0">
                    {h.linkLabel}
                    <span class="sr-only"> – {h.title}</span>
                    <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1">→</span>
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= FULL-WIDTH PHOTO BAND (parallax) ======================= -->
  <section class="relative isolate flex min-h-[80svh] items-center overflow-hidden bg-ink-900" aria-label="The valley">
    <div class="absolute inset-x-0 -top-[15%] -z-10 h-[130%]" data-parallax-bg>
      <Photo image={band.image} widths={[640, 1024, 1600, 2400]} sizes="100vw" class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 -z-10 bg-ink-900/45"></div>
    <div class="container-page text-center">
      <Divider tone="dark" class="mb-10" />
      <h2 class="mx-auto max-w-4xl font-serif text-4xl leading-tight font-medium text-cream-50 italic sm:text-6xl" data-split>“{band.quote}”</h2>
    </div>
  </section>

  <!-- ======================= REVIEWS ======================= -->
  <section class="py-24 sm:py-36" aria-labelledby="reviews-title">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-4" data-fade>Guest reviews</p>
        <h2 id="reviews-title" class="text-5xl text-primary-800 sm:text-6xl lg:text-7xl" data-split>What our guests say</h2>
        <GoldLine class="mx-auto mt-10 w-48" />
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          reviews.map((r) => (
            <figure class="flex flex-col rounded-[1.75rem] bg-cream-100 p-8 sm:p-10" data-fade>
              <Stars rating={r.rating} />
              <blockquote class="mt-6 flex-1 font-serif text-2xl leading-snug text-ink-900 sm:text-[1.7rem]">
                <p>“{r.quote}”</p>
              </blockquote>
              <figcaption class="mt-8 border-t border-accent-500/30 pt-5 text-sm">
                <span class="font-semibold text-ink-900">{r.name}</span>
                <span class="text-ink-500"> · {r.country}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
