---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RevealImage from '../components/RevealImage.astro';
import GoldLine from '../components/GoldLine.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { seo, rooms, roomPolicies, pageHeroes, hotel } from '../data/hotel';
---

<BaseLayout title={seo.rooms.title} description={seo.rooms.description} ogImage={pageHeroes.rooms} heroImage={pageHeroes.rooms}>
  <PageHero
    image={pageHeroes.rooms}
    eyebrow={`${hotel.totalRooms} rooms & suites`}
    title="Rooms designed for rest"
    subtitle="Every room combines traditional Bhutanese craftsmanship with modern comfort. Breakfast is always included."
  />

  <section class="py-24 sm:py-36">
    <div class="container-page">
      <SectionHeading divider eyebrow="Choose your room" title="Three ways to stay" />

      <div class="mt-20 space-y-24 lg:space-y-40">
        {
          rooms.map((room, i) => (
            <article id={room.id} class="grid scroll-mt-28 items-center gap-10 lg:grid-cols-12 lg:gap-10">
              <!-- Room card image: 3D tilt + zoom on hover -->
              <div class:list={['group lg:col-span-7', i % 2 === 1 && 'lg:order-2 lg:col-start-6']} data-tilt>
                <RevealImage
                  image={room.image}
                  widths={[480, 800, 1200, 1400]}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  class="aspect-7/5 rounded-[2rem] shadow-2xl"
                />
              </div>
              <div class:list={['lg:col-span-5', i % 2 === 1 ? 'lg:order-1 lg:col-start-1 lg:pr-6' : 'lg:pl-6']}>
                <p class="font-sans text-xs tracking-[0.25em] text-accent-700" data-fade>0{i + 1} / 0{rooms.length}</p>
                <h2 class="mt-3 text-5xl text-primary-800 sm:text-6xl" data-split>{room.name}</h2>
                <p class="mt-4 text-lg" data-fade>
                  <span class="text-ink-500">from </span>
                  <span class="font-serif text-4xl font-semibold text-primary-700">{hotel.currency} {room.priceFrom}</span>
                  <span class="text-ink-500"> / night</span>
                </p>
                <p class="mt-5 text-lg leading-relaxed text-ink-700" data-fade>{room.summary}</p>

                <dl class="mt-8 grid grid-cols-3 gap-3 border-y border-accent-500/30 py-5 text-sm" data-fade>
                  <div>
                    <dt class="text-ink-500">Size</dt>
                    <dd class="mt-1 font-semibold text-ink-900">{room.size}</dd>
                  </div>
                  <div>
                    <dt class="text-ink-500">Bed</dt>
                    <dd class="mt-1 font-semibold text-ink-900">{room.bed}</dd>
                  </div>
                  <div>
                    <dt class="text-ink-500">Max guests</dt>
                    <dd class="mt-1 font-semibold text-ink-900">{room.maxGuests}</dd>
                  </div>
                </dl>

                <h3 class="mt-8 font-sans text-xs font-semibold tracking-[0.2em] text-ink-900 uppercase" data-fade>Amenities</h3>
                <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-ink-700" data-fade>
                  {room.amenities.map((a) => (
                    <li class="flex items-start gap-2.5">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rotate-45 bg-accent-500" aria-hidden="true" />
                      {a}
                    </li>
                  ))}
                </ul>

                <div data-fade>
                  <a href={`/contact/?room=${room.id}#booking`} class="btn-primary mt-10">
                    Check availability<span class="sr-only"> for the {room.name}</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <GoldLine class="mt-28 mb-20" />

      <div class="rounded-[2rem] bg-primary-800 p-8 text-cream-100 sm:p-14" data-fade>
        <h2 class="text-4xl text-cream-50 sm:text-5xl">Good to know</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {roomPolicies.map((p) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-2 w-2 shrink-0 rotate-45 bg-accent-400" aria-hidden="true" />
              {p}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
