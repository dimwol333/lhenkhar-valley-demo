---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { seo, gallery, pageHeroes } from '../data/hotel';

// Large versions for the lightbox (only downloaded when a photo is opened).
const items = await Promise.all(
  gallery.map(async (img) => {
    const large = await getImage({
      src: img.src,
      ...(typeof img.src === 'string' ? { width: img.width, height: img.height } : {}),
      widths: [800, 1600],
      format: 'webp',
      quality: 78,
    });
    const w = typeof img.src === 'string' ? img.width : img.src.width;
    const h = typeof img.src === 'string' ? img.height : img.src.height;
    return { img, large, w, h };
  }),
);
---

<BaseLayout title={seo.gallery.title} description={seo.gallery.description} ogImage={pageHeroes.gallery} heroImage={pageHeroes.gallery}>
  <PageHero image={pageHeroes.gallery} eyebrow="Gallery" title="A glimpse of Lhenkhar Valley" />

  <section class="py-24 sm:py-36">
    <div class="container-page">
      <SectionHeading divider title="Rooms, food and views" intro="Select any photo to see it larger. Use the arrow keys or swipe to browse." />

      <ul class="mt-16 columns-1 gap-5 sm:columns-2 lg:columns-3 lg:gap-6" data-gallery>
        {
          items.map(({ img, large, w, h }, i) => (
            <li class="mb-5 break-inside-avoid lg:mb-6" data-fade>
              <a
                href={large.src}
                class="group block overflow-hidden rounded-2xl bg-cream-200 focus-visible:outline-offset-4"
                data-index={i}
                data-srcset={large.srcSet.attribute}
                data-alt={img.alt}
                data-w={w}
                data-h={h}
                data-cursor="view"
                aria-label={`View larger: ${img.alt}`}
              >
                <Photo
                  image={img}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-auto w-full transition-[scale] duration-1000 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-[1.05]"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lightbox (src/scripts/animations/lightbox.ts) -->
  <dialog class="m-0 h-full max-h-none w-full max-w-none overflow-hidden bg-transparent p-0 text-cream-50 backdrop:bg-transparent" aria-label="Photo viewer" data-lightbox>
    <div class="absolute inset-0 bg-ink-900/95" data-lb-bg></div>
    <div class="relative flex h-full flex-col">
      <div class="flex items-center justify-between p-3 sm:p-5" data-lb-ui>
        <p class="text-sm tracking-wide text-cream-100" aria-live="polite" data-lb-count></p>
        <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full hover:bg-cream-50/10" data-lb-close>
          <span class="sr-only">Close</span>
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-24" data-lb-stage>
        <img class="max-w-none rounded-lg object-cover shadow-2xl will-change-transform" alt="Enlarged gallery photo" sizes="(min-width: 1024px) 80vw, 100vw" data-lb-img />
      </div>
      <p class="px-4 py-5 text-center text-cream-100 sm:py-6" data-lb-ui data-lb-caption></p>
      <button type="button" class="absolute top-1/2 left-2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-ink-900/60 hover:bg-cream-50/15 sm:left-6" data-lb-ui data-lb-prev>
        <span class="sr-only">Previous photo</span>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="absolute top-1/2 right-2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-ink-900/60 hover:bg-cream-50/15 sm:right-6" data-lb-ui data-lb-next>
        <span class="sr-only">Next photo</span>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </dialog>
</BaseLayout>
