---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RevealImage from '../components/RevealImage.astro';
import Divider from '../components/Divider.astro';
import Marquee from '../components/Marquee.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { seo, dining, menu, pageHeroes } from '../data/hotel';
---

<BaseLayout title={seo.dining.title} description={seo.dining.description} ogImage={pageHeroes.dining} heroImage={pageHeroes.dining}>
  <PageHero
    image={pageHeroes.dining}
    eyebrow={dining.restaurantName}
    title="The taste of Bhutan"
    subtitle="Home-style Bhutanese cooking with chillies, cheese and red rice from the farms around Damphu."
  />

  <section class="py-24 sm:py-36">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="Our restaurant" title={`Welcome to ${dining.restaurantName}`} align="left" />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-700">
          {dining.intro.map((p) => <p data-fade>{p}</p>)}
        </div>
        <div class="mt-10 border-t border-accent-500/40 pt-6" data-fade>
          <h2 class="font-sans text-xs font-semibold tracking-[0.2em] text-ink-900 uppercase">Opening hours</h2>
          <dl class="mt-4 space-y-3">
            {
              dining.hours.map((h) => (
                <div class="flex justify-between gap-4 border-b border-cream-200 pb-3 last:border-0">
                  <dt class="text-ink-700">{h.meal}</dt>
                  <dd class="font-serif text-xl font-semibold text-ink-900">{h.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <div class="grid grid-cols-5 gap-4">
        <RevealImage image={dining.image} widths={[400, 640, 900]} sizes="(min-width: 1024px) 28vw, 60vw" class="col-span-3 aspect-3/4 rounded-[1.75rem] shadow-2xl" />
        <RevealImage image={dining.secondaryImage} widths={[300, 500]} sizes="(min-width: 1024px) 18vw, 40vw" class="col-span-2 mt-20 aspect-3/4 rounded-[1.75rem] shadow-xl" />
      </div>
    </div>
  </section>

  <Marquee words={['Ema Datshi', 'Red Rice', 'Momos', 'Suja', 'Kewa Datshi', 'Farm to Table']} tone="dark" />

  <section class="py-24 sm:py-36" aria-labelledby="menu-title">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <Divider class="mb-8" />
        <p class="eyebrow mb-4" data-fade>Sample menu</p>
        <h2 id="menu-title" class="text-5xl text-primary-800 sm:text-6xl lg:text-7xl" data-split>Bhutanese favourites</h2>
        <p class="mt-6 text-lg text-ink-700" data-fade>Prices in Bhutanese Ngultrum (Nu.). Every dish can be made mild on request.</p>
      </div>

      <div class="mx-auto mt-16 max-w-4xl space-y-16">
        {
          menu.map((section) => (
            <div>
              <h3 class="border-b border-accent-500 pb-4 text-4xl text-primary-800" data-split>{section.category}</h3>
              <ul class="mt-2 divide-y divide-cream-200">
                {section.items.map((item) => (
                  <li class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-8" data-fade>
                    <div class="flex-1">
                      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <span class="font-serif text-3xl font-semibold text-ink-900">{item.name}</span>
                        {item.vegetarian && (
                          <span class="rounded-full bg-[#e6f2e6] px-2.5 py-0.5 text-xs font-semibold text-[#1d5c2a]">Vegetarian</span>
                        )}
                        {item.spicy && (
                          <span class="rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800">Spicy</span>
                        )}
                      </p>
                      <p class="mt-1.5 leading-relaxed text-ink-700">{item.description}</p>
                    </div>
                    <p class="font-serif text-2xl font-semibold whitespace-nowrap text-primary-700">{item.price}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
